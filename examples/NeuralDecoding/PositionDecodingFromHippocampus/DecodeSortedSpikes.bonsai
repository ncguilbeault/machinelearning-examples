<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.8.5"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:py="clr-namespace:Bonsai.Scripting.Python;assembly=Bonsai.Scripting.Python"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns:p1="clr-namespace:Bonsai.ML.Design;assembly=Bonsai.ML.Design"
                 xmlns:p2="clr-namespace:Bonsai.ML.NeuralDecoder.Design;assembly=Bonsai.ML.NeuralDecoder.Design"
                 xmlns:viz="clr-namespace:Bonsai.Design.Visualizers;assembly=Bonsai.Design.Visualizers"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:CreateRuntime">
          <py:PythonHome />
        </Combinator>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Bonsai.ML.NeuralDecoder:ImportDecoderModule.bonsai" />
      <Expression xsi:type="IncludeWorkflow" Path="Bonsai.ML.NeuralDecoder:LoadSortedSpikeDecoder.bonsai">
        <Name>decoder</Name>
        <DecoderPath>C:\\Users\\ncgui\\Desktop\\machinelearning\\docs\\examples\\datasets\\HippocampalTetrodeRecordings\\decoder_data\\sorted_spike_decoder.pkl</DecoderPath>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>DecoderModel</Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Bonsai.ML.NeuralDecoder:LoadDecodedResultsFromFile.bonsai">
        <ResultsPath>C:\\Users\\ncgui\\Desktop\\machinelearning\\docs\\examples\\datasets\\HippocampalTetrodeRecordings\\decoder_data\\sorted_spike_decoding_results.pkl</ResultsPath>
        <SamplingFrequency>PT0.01S</SamplingFrequency>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>Data</Name>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>ConvertToPoint</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Position2D</Selector>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>it[0].ToString()</scr:Expression>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>it == "nan" ? double.NaN : Convert.ToDouble(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>it[1].ToString()</scr:Expression>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>it == "nan" ? double.NaN : Convert.ToDouble(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="InputMapping">
              <PropertyMappings>
                <Property Name="X" Selector="Item1" />
                <Property Name="Y" Selector="Item2" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="cv:CreatePoint2f">
                <cv:X>4.88269329</cv:X>
                <cv:Y>24.8296967</cv:Y>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="1" To="4" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="6" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="6" Label="Source2" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>Centroid</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Data</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Position2D</Selector>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Bonsai.ML.NeuralDecoder:LinearizePosition.bonsai">
        <Name>decoder</Name>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>LinearPosition</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Data</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Spikes</Selector>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Bonsai.ML.NeuralDecoder:PerformInference.bonsai">
        <Name>decoder</Name>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>Posterior</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Data</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>PositionBins2D</Selector>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Bonsai.ML.NeuralDecoder:GetPosterior2D.bonsai">
        <Name>decoder</Name>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>Posterior2D</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Posterior</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SubscribeWhen" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:GetRuntime" />
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Bonsai.ML.NeuralDecoder:GetTrackGraph.bonsai">
        <Name>decoder</Name>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>TrackGraph</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Posterior</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SubscribeWhen" />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>VisualizeDecoder</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="SubscribeSubject">
              <Name>Centroid</Name>
            </Expression>
            <Expression xsi:type="VisualizerMapping" />
            <Expression xsi:type="SubscribeSubject">
              <Name>TrackGraph</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Nodes</Selector>
            </Expression>
            <Expression xsi:type="VisualizerMapping">
              <VisualizerType xsi:type="TypeMapping" TypeArguments="p1:MultidimensionalArrayVisualizer" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Posterior2D</Name>
            </Expression>
            <Expression xsi:type="VisualizerMapping">
              <VisualizerType xsi:type="TypeMapping" TypeArguments="p2:Posterior2DVisualizer" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>LinearPosition</Name>
            </Expression>
            <Expression xsi:type="VisualizerMapping" />
            <Expression xsi:type="SubscribeSubject">
              <Name>Posterior</Name>
            </Expression>
            <Expression xsi:type="VisualizerMapping">
              <VisualizerType xsi:type="TypeMapping" TypeArguments="p2:Posterior1DVisualizer" />
            </Expression>
            <Expression xsi:type="viz:TableLayoutPanelBuilder">
              <viz:ColumnCount>2</viz:ColumnCount>
              <viz:RowCount>1</viz:RowCount>
              <viz:ColumnStyles />
              <viz:RowStyles />
              <viz:CellSpans />
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="5" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source2" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="11" Label="Source1" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source2" />
            <Edge From="11" To="12" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="10" To="11" Label="Source1" />
      <Edge From="12" To="13" Label="Source1" />
      <Edge From="13" To="14" Label="Source1" />
      <Edge From="14" To="15" Label="Source1" />
      <Edge From="16" To="17" Label="Source1" />
      <Edge From="17" To="18" Label="Source1" />
      <Edge From="18" To="19" Label="Source1" />
      <Edge From="19" To="21" Label="Source1" />
      <Edge From="20" To="21" Label="Source2" />
      <Edge From="22" To="23" Label="Source1" />
      <Edge From="23" To="24" Label="Source1" />
      <Edge From="24" To="26" Label="Source1" />
      <Edge From="25" To="26" Label="Source2" />
    </Edges>
  </Workflow>
</WorkflowBuilder>