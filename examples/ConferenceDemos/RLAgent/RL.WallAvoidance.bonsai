              </Combinator>
            </Expression>
            <Expression xsi:type="p1:ToArray">
              <p1:Type xsi:type="TypeMapping" TypeArguments="sys:Double" />
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>NormalizedQValues</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>QValues</Name>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>it.argmax().ReadCpuInt64(0)</scr:Expression>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>QValuesArgmax</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>EndEpisode</Name>
